# ===== Majburiy =====
# @BotFather'dan olingan token
BOT_TOKEN=1234567890:AAAA...

# Admin(lar) Telegram ID si, vergul bilan (ID ni @userinfobot dan bilib olasiz)
ADMIN_IDS=123456789

# ===== Ixtiyoriy =====
# Bir vaqtda nechta yuklash (qolganlar navbatda). 2 vCPU server uchun 4 yaxshi.
MAX_PARALLEL=4
# Bitta foydalanuvchi bir vaqtda nechta yuklash qila oladi
PER_USER_LIMIT=2
# Havola kelganda sifat tanlash tugmalarini ko'rsatish (1) yoki darhol yuklash (0)
ASK_QUALITY=1
# Tanlovdagi eng yuqori sifat: 1080, 1440 (2K), 2160 (4K)
MAX_QUALITY=1440
# Tanlov bo'lmaganda (TikTok, guruhlar va h.k.) avtomatik sifat
VIDEO_QUALITY=720
# Maksimal davomiylik (soniya) va bitta yuklash uchun maksimal vaqt (soniya)
MAX_DURATION=10800
DOWNLOAD_TIMEOUT=900
# Kesh muddati (kun) — bir xil havola qayta so'ralsa, darhol yuboriladi
CACHE_DAYS=30

# Majburiy obuna: @kanal yoki -100ID|https://t.me/+taklif (vergul bilan). Bot kanalda admin bo'lishi shart.
# REQUIRED_CHANNELS=@mening_kanalim

# /help da ko'rsatiladigan aloqa (DMCA shikoyatlari uchun ham)
# CONTACT=@admin_username

# Instagram/YouTube login so'rasa — cookies.txt (Netscape formatida).
# Standart joy: cookies/cookies.txt (shu papkaga qo'ysangiz yetarli, bu qatorni o'zgartirmang)
# COOKIES_FILE=cookies/cookies.txt

# DNS zaxirasi: server DNS i nomni topa olmasa, DNS-over-HTTPS (1.1.1.1 / 8.8.8.8, 443-port)
# orqali so'raladi. O'chirish uchun 0.
DOH_FALLBACK=1

# Sayt server IP'ini bloklasa — proxy (http://, socks5://)
# PROXY=socks5://user:pass@host:1080

# ===== Local Bot API (2 GB gacha fayllar) =====
# https://my.telegram.org dan olinadi
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# LOCAL_API_URL=http://telegram-bot-api:8081
# MAX_FILE_MB=2000

# ===== YouTube 403 bo'lsa: PO Token serveri =====
# POT_PROVIDER_URL=http://pot-provider:4416

# Qaysi qo'shimcha xizmatlar ishga tushadi (docker compose up -d da --profile yozish shart emas):
# localapi — 2 GB gacha fayllar, youtube — PO Token serveri
# COMPOSE_PROFILES=localapi,youtube

# Docker ishga tushganda yt-dlp ni avtomatik yangilash (1/0)
AUTO_UPDATE=1
